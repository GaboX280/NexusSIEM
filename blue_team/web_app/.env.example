# Local-only configuration for NexusSIEM development/demo.
# Copy this file to the repository root as .env.
# These demo credentials are for localhost testing only; never use them in Azure.
NEXUS_ENV=development
NEXUS_ADMIN_USER=localadmin
NEXUS_ADMIN_PASSWORD=local-dev-change-me
NEXUS_TEAMS_WEBHOOK=
# Optional local overrides:
# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=5000
